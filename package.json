{
  "name": "markmathew-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/check.mjs",
    "preview": "node scripts/cloudflare-local.mjs preview",
    "check": "node scripts/check.mjs",
    "check:preview": "node scripts/check-preview.mjs",
    "check:cloudflare": "node scripts/cloudflare-local.mjs check",
    "prepare:staging": "node scripts/prepare-staging.mjs",
    "check:staging": "node scripts/check-staging.mjs && node scripts/cloudflare-local.mjs check-staging"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  },
  "overrides": {
    "miniflare": { "undici": "7.30.1" }
  }
}
