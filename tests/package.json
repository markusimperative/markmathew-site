{
  "name": "portfolio-browser-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:behavior": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:update-screenshots": "playwright test --grep @visual --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "playwright-core": "1.63.0"
  }
}
