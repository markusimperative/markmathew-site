{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markmathew-site",
  "compatibility_date": "2026-10-25",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "markmathew.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
